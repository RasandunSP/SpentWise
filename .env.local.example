# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the two values.
#
# Supabase dashboard → your project → Settings → API
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key. This one is meant to be public — every
# table is locked down by Row Level Security, so it can only ever read or
# write rows belonging to the signed-in user.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Do NOT put the service_role / secret key in this file. It bypasses RLS, and
# anything prefixed NEXT_PUBLIC_ is shipped to the browser. Nothing in this app
# needs it.
